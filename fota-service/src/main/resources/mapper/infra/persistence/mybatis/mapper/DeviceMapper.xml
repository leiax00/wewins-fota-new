<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wewins.fota.infra.persistence.mybatis.mapper.DeviceMapper">

    <!-- 批量更新设备信息（使用 CASE WHEN 兼容 PostgreSQL 和 MySQL） -->
    <update id="batchUpdateDeviceInfo">
        UPDATE devices
        SET
            first_seen_at = CASE id
            <foreach collection="list" item="item">
                <if test="item.firstSeenAt != null">
                    WHEN #{item.id} THEN #{item.firstSeenAt}
                </if>
            </foreach>
            ELSE first_seen_at END,
            last_seen_at = CASE id
            <foreach collection="list" item="item">
                WHEN #{item.id} THEN #{item.lastSeenAt}
            </foreach>
            ELSE last_seen_at END,
            version_parts = CASE id
            <foreach collection="list" item="item">
                <if test="item.versionPartsJson != null">
                    WHEN #{item.id} THEN #{item.versionPartsJson}
                </if>
            </foreach>
            ELSE version_parts END,
            initial_version_parts = CASE id
            <foreach collection="list" item="item">
                <if test="item.initialVersionPartsJson != null">
                    WHEN #{item.id} THEN #{item.initialVersionPartsJson}
                </if>
            </foreach>
            ELSE initial_version_parts END,
            updated_at = CURRENT_TIMESTAMP
        WHERE id IN
        <foreach collection="list" item="item" open="(" separator="," close=")">
            #{item.id}
        </foreach>
    </update>

    <!-- 批量更新设备标签（兼容 PostgreSQL 和 MySQL） -->
    <update id="batchUpdateTags">
        UPDATE devices
        SET tags = #{tagsJson},
            updated_at = CURRENT_TIMESTAMP
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

</mapper>
