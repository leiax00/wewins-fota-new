<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.wewins</groupId>
        <artifactId>wewins-fota-new</artifactId>
        <version>0.2.0</version>
    </parent>

    <artifactId>fota-module-system</artifactId>
    <name>fota-module-system</name>
    <description>FOTA system management module (user, role, permission, dictionary)</description>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.wewins</groupId>
                <artifactId>fota-bom</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Framework modules -->
        <dependency>
            <groupId>com.wewins</groupId>
            <artifactId>fota-framework-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wewins</groupId>
            <artifactId>fota-framework-database</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wewins</groupId>
            <artifactId>fota-framework-web</artifactId>
        </dependency>

        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
