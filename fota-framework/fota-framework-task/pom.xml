<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.wewins</groupId>
        <artifactId>fota-framework</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>fota-framework-task</artifactId>
    <name>fota-framework-task</name>
    <description>FOTA framework async task module with SSE support</description>

    <dependencies>
        <!-- Framework modules -->
        <dependency>
            <groupId>com.wewins</groupId>
            <artifactId>fota-framework-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wewins</groupId>
            <artifactId>fota-framework-database</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wewins</groupId>
            <artifactId>fota-framework-web</artifactId>
        </dependency>

        <!-- Spring Web (for SSE) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring WebFlux (for reactive SSE) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
